# ============================================================
# Lab 2 - Seven Segment Display (ESP-IDF + Wokwi)
# Keeps source/config plus only the binaries Wokwi flashes.
# ============================================================

# ESP-IDF / CMake / Ninja output
**/build/*
!**/build/flasher_args.json
!**/build/*.bin
!**/build/*.elf

# Wokwi needs these two files from the subfolders as well.
!**/build/bootloader/
**/build/bootloader/*
!**/build/bootloader/bootloader.bin

!**/build/partition_table/
**/build/partition_table/*
!**/build/partition_table/partition-table.bin

# Generated per-project configuration (recreated by idf.py set-target)
**/sdkconfig
**/sdkconfig.old

# Object files, maps, dependency files and logs
*.o
*.obj
*.a
*.map
*.d
*.log
*.tmp
*.temp

# OS / editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
