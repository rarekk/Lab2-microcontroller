{
  "version": 1,
  "author": "Embedded Engineering Lab",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 140, "left": 180, "attrs": { "color": "green", "label": "PRESS (GPIO4)", "key": "b", "bounce": "1" } },
    { "type": "wokwi-led", "id": "led1", "top": 40, "left": 180, "attrs": { "color": "red", "label": "LED (GPIO2)" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 40, "left": 300, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:4", "btn1:1.l", "green", [ "v0" ] ],
    [ "btn1:2.l", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:2", "r1:1", "blue", [ "v0" ] ],
    [ "r1:2", "led1:A", "red", [ "v0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ]
  ]
}
