{
  "version": 1,
  "author": "Embedded Engineering Lab",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": -90, "left": 200, "attrs": { "value": "512", "label": "BRIGHTNESS" } },
    { "type": "wokwi-led", "id": "led1", "top": 170, "left": 200, "attrs": { "color": "yellow", "label": "PWM LED (GPIO2)" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 170, "left": 320, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:3V3", "pot1:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "pot1:GND", "black", [ "v0" ] ],
    [ "esp:34", "pot1:SIG", "orange", [ "v0" ] ],
    [ "esp:2", "r1:1", "blue", [ "v0" ] ],
    [ "r1:2", "led1:A", "red", [ "v0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ]
  ]
}
